VITE_VAPT_API_BASE_URL=https://your-vapt-api-host
VITE_PAYMENT_ENVIRONMENT=production
# Altere para r2 apenas após API, bucket público e CORS estarem validados.
VITE_MENU_IMAGE_STORAGE_MODE=disabled
VITE_PUBLIC_CATALOG_EVENTS_ENABLED=false
# Manter true no rollback do reader enquanto houver writer/operacoes aceitas.
VITE_PUBLIC_CATALOG_WRITER_ENABLED=false

VITE_VAPID_PUBLIC_KEY=your-web-push-public-key
