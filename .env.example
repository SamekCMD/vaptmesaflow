VITE_SUPABASE_URL=https://supabase.vapt.app.br
# Chave anon/publishable pública do Supabase self-hosted; nunca use a service role.
VITE_SUPABASE_ANON_KEY=replace-with-browser-safe-anon-key

# Stripe via n8n foi aposentado. Estas variáveis ficam ausentes até a migração direta futura.
VITE_LEGACY_STRIPE_ENABLED=false
# VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...
# VITE_STRIPE_PRICE_STARTER=price_...
# VITE_STRIPE_PRICE_PRO=price_...
# VITE_STRIPE_PRICE_BUSINESS=price_...

VITE_VAPT_API_BASE_URL=https://api.vapt.app.br
VITE_PAYMENT_ENVIRONMENT=sandbox

# Push ainda depende do ingest legado; deixe VAPID desligado até a persistência direta ser portada.
# VITE_VAPID_PUBLIC_KEY=replace-with-public-vapid-key
# VITE_TURNSTILE_SITE_KEY=replace-with-public-turnstile-site-key
VITE_TURNSTILE_ENABLED=false
