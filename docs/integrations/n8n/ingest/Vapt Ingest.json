    {
      "parameters": {
        "jsCode": "const input=$input.first().json;const expected=$env.VAPT_APP_ENDPOINT_SECRET;const provided=input.request_headers['x-vapt-app-key']??input.request_headers['X-Vapt-App-Key'];if(!expected||provided!==expected){return [{json:{...input,halt:true,statusCode:401,body:{error:'unauthorized',message:'Invalid app endpoint secret'}}}];}return $input.all();"
      },
      "id": "authorize-push",
      "name": "Authorize Push Subscription Request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -940,
        -760
      ]
    },
    {
      "parameters": {
        "jsCode": "const input=$input.first().json;if(input.halt||input.body?.error){return $input.all();}const body=input.request_body??{};if(body.action!=='subscribe'||!body.restaurant_id||!body.subscription||typeof body.subscription!=='object'||!body.endpoint){return [{json:{...input,halt:true,statusCode:400,body:{error:'invalid_configuration',message:'action, restaurant_id, subscription, and endpoint are required'}}}];}return [{json:{...input,restaurant_id:body.restaurant_id,subscription:body.subscription,endpoint:body.endpoint,origin:body.origin??null,user_agent:body.user_agent??null,created_at:body.created_at??new Date().toISOString()}}];"
      },
      "id": "validate-push-subscription",
      "name": "Validate Push Subscription Payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -720,
        -760
      ]
    },
    {
      "parameters": {
        "method": "POST",
      "url": "={{ $env.VAPT_SUPABASE_URL.replace(/\\/$/, '') + '/rest/v1/push_subscriptions?on_conflict=endpoint' }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { restaurant_id: $json.restaurant_id, endpoint: $json.endpoint, subscription: $json.subscription, origin: $json.origin, user_agent: $json.user_agent, created_at: $json.created_at, updated_at: $json.created_at } }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $env.VAPT_SUPABASE_SERVICE_KEY }}"
            },
            {
              "name": "Authorization",
              "value": "={{ 'Bearer ' + $env.VAPT_SUPABASE_SERVICE_KEY }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "Prefer",
              "value": "resolution=merge-duplicates,return=representation"
            }
          ]
        },
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      },
      "id": "persist-push-subscription",
      "name": "Persist Push Subscription",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.3,
