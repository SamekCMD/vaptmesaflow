    {
      "parameters": {
        "jsCode": "const input=$input.first().json;if(input.halt||input.body?.error){return $input.all();}const body=input.request_body??{};const rating=Number(body.rating);const reasons=Array.isArray(body.reasons)?body.reasons:[];if(!body.order_id||!body.restaurant_id||!Number.isInteger(rating)||rating<1||rating>5){return [{json:{...input,halt:true,statusCode:400,body:{error:'invalid_configuration',message:'order_id, restaurant_id, and a rating between 1 and 5 are required'}}}];}return [{json:{...input,order_id:body.order_id,restaurant_id:body.restaurant_id,rating,reasons,comment:body.comment??null,created_at:body.created_at??new Date().toISOString()}}];"
      },
