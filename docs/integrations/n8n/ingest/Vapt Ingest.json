    {
      "parameters": {
        "jsCode": "const input = $input.first().json;\nconst payload = Array.isArray(input) ? input[0] : input;\nreturn [{ json: { success: true, route: 'ingest.push-subscription', restaurant_id: payload?.restaurant_id ?? null, endpoint: payload?.endpoint ?? null, status: 'saved' } }];"
      },
