# Este arquivo documenta somente o overlay Vapt. Gere os secrets com as ferramentas
# da release oficial e mantenha o .env real apenas no cofre do Coolify/host.
SUPABASE_PUBLIC_URL=https://supabase.vapt.app.br
API_EXTERNAL_URL=https://supabase.vapt.app.br/auth/v1
SITE_URL=https://dashboard.vapt.app.br
ADDITIONAL_REDIRECT_URLS=https://dashboard.vapt.app.br/**,https://vaptmesaflow-*-contatoupboost-2301s-projects.vercel.app/**
PROXY_DOMAIN=supabase.vapt.app.br

# Gerar na instalação; nunca commitar valores reais.
POSTGRES_PASSWORD=replace-with-generated-secret
JWT_SECRET=replace-with-generated-secret
ANON_KEY=replace-with-generated-public-api-key
SERVICE_ROLE_KEY=replace-with-generated-server-only-key
SUPABASE_PUBLISHABLE_KEY=replace-with-generated-public-opaque-key
SUPABASE_SECRET_KEY=replace-with-generated-server-only-opaque-key
JWT_KEYS=replace-with-generated-private-jwk-set
JWT_JWKS=replace-with-generated-public-jwk-set
SECRET_KEY_BASE=replace-with-generated-64-character-secret
REALTIME_DB_ENC_KEY=replace-with-generated-16-character-key
VAULT_ENC_KEY=replace-with-generated-32-character-key
PG_META_CRYPTO_KEY=replace-with-generated-32-character-secret
S3_PROTOCOL_ACCESS_KEY_ID=replace-with-generated-access-key-id
S3_PROTOCOL_ACCESS_KEY_SECRET=replace-with-generated-access-key-secret
DASHBOARD_USERNAME=replace-with-generated-admin-user
DASHBOARD_PASSWORD=replace-with-generated-admin-password

POSTGRES_HOST=db
POSTGRES_DB=postgres
POSTGRES_PORT=5432
POOLER_PROXY_PORT_TRANSACTION=6543
POOLER_DEFAULT_POOL_SIZE=20
POOLER_MAX_CLIENT_CONN=100
POOLER_TENANT_ID=vapt
POOLER_DB_POOL_SIZE=5
STUDIO_DEFAULT_ORGANIZATION=Vapt
STUDIO_DEFAULT_PROJECT=Vapt
JWT_EXPIRY=3600
DISABLE_SIGNUP=false
ENABLE_EMAIL_SIGNUP=true
ENABLE_EMAIL_AUTOCONFIRM=false
ENABLE_PHONE_SIGNUP=false
ENABLE_PHONE_AUTOCONFIRM=false
GLOBAL_S3_BUCKET=vapt
REGION=local
STORAGE_TENANT_ID=vapt
FUNCTIONS_VERIFY_JWT=true
PGRST_DB_SCHEMAS=public,graphql_public
PGRST_DB_MAX_ROWS=1000
PGRST_DB_EXTRA_SEARCH_PATH=public,extensions
API_GW_HTTP_PORT=8000
KONG_HTTP_PORT=8000
KONG_HTTPS_PORT=8443
ANON_KEY_ASYMMETRIC=replace-with-generated-public-api-key
SERVICE_ROLE_KEY_ASYMMETRIC=replace-with-generated-server-only-key
IMGPROXY_AUTO_WEBP=true

# SMTP/Resend/Auth Hook/Redis não são definidos aqui: pertencem ao WIP de email.
