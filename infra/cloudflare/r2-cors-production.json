{
  "rules": [
    {
      "allowed": {
        "origins": [
          "https://vapt.app.br",
          "https://dashboard.vapt.app.br"
        ],
        "methods": ["PUT"],
        "headers": ["Content-Type", "Content-Length"]
      },
      "exposeHeaders": ["ETag"],
      "maxAgeSeconds": 3600
    }
  ]
}
