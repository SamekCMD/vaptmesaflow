{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "vapt-billing-email-production",
  "main": "src/index.ts",
  "compatibility_date": "2025-12-01",
  "workers_dev": false,
  "preview_urls": false,
  "vars": { "ENVIRONMENT": "production" },
  "triggers": { "crons": ["* * * * *"] },
  "queues": {
    "producers": [{ "binding": "BILLING_EMAIL_QUEUE", "queue": "vapt-emails-production" }],
    "consumers": [{
      "queue": "vapt-emails-production",
      "max_batch_size": 10,
      "max_retries": 3,
      "retry_delay": 60,
      "dead_letter_queue": "vapt-emails-production-dlq"
    }]
  }
}
